# ERPNext 16 站点与应用配置模板
ERPNEXT_SITE_URL=http://localhost:8000
ERPNEXT_VERSION=16
ERPNEXT_APP_NAME=erpnext

# 管理员/API 用户登录凭据
ERPNEXT_USERNAME=your_username
ERPNEXT_PASSWORD=your_password

# API Key 与 API Secret (在 ERPNext 用户的 Key Details 中生成)
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# ERPNext Authorization Header Token 格式: token {API_KEY}:{API_SECRET}
ERPNEXT_TOKEN=token your_api_key:your_api_secret

# GitHub 账号与远程代码库配置
GITHUB_USER=your_github_username
GITHUB_EMAIL=your_github_email
GITHUB_REPO_URL=https://github.com/your_username/your_repo.git

