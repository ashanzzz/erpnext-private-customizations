{
  "name": "Property Charge Rate",
  "module": "Ashan CN Procurement",
  "doctype": "DocType",
  "custom": 0,
  "issingle": 0,
  "istable": 0,
  "autoname": "format:{property_lease}-{effective_from}",
  "fields": [
    {
      "label": "租赁物业",
      "fieldname": "property_lease",
      "fieldtype": "Link",
      "options": "Property Lease",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "生效起始日期",
      "fieldname": "effective_from",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "计费方式",
      "fieldname": "billing_method",
      "fieldtype": "Select",
      "options": "年金额\n按天每平方米",
      "default": "年金额",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "年含税金额",
      "fieldname": "annual_amount_tax_incl",
      "fieldtype": "Currency",
      "in_list_view": 1
    },
    {
      "label": "年不含税金额",
      "fieldname": "annual_amount_tax_excl",
      "fieldtype": "Currency"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_rate_1"
    },
    {
      "label": "含税日单价/㎡",
      "fieldname": "daily_rate_tax_incl",
      "fieldtype": "Currency"
    },
    {
      "label": "不含税日单价/㎡",
      "fieldname": "daily_rate_tax_excl",
      "fieldtype": "Currency"
    },
    {
      "label": "税率(%)",
      "fieldname": "tax_rate",
      "fieldtype": "Percent",
      "default": "9.0"
    },
    {
      "label": "启用",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "label": "备注说明",
      "fieldname": "remark",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "All",
      "read": 1
    }
  ]
}